From 941bd0f7b4f0982edce5dbe931a1f9af8da98d09 Mon Sep 17 00:00:00 2001
From: Hien Huynh <hien.huynh.px@renesas.com>
Date: Mon, 10 Mar 2025 06:06:37 +0700
Subject: [PATCH 1/2] usb: add dma-mempool for EHCI and OHCI

Add dma-mempool for EHCI and OHCI.

Signed-off-by: Hien Huynh <hien.huynh.px@renesas.com>
---
 drivers/usb/host/ehci-platform.c | 19 +++++++++++++++++++
 drivers/usb/host/ohci-platform.c | 19 +++++++++++++++++++
 2 files changed, 38 insertions(+)

diff --git a/drivers/usb/host/ehci-platform.c b/drivers/usb/host/ehci-platform.c
index bced6c60b918..169d5bb62e76 100644
--- a/drivers/usb/host/ehci-platform.c
+++ b/drivers/usb/host/ehci-platform.c
@@ -27,6 +27,7 @@
 #include <linux/io.h>
 #include <linux/module.h>
 #include <linux/of.h>
+#include <linux/of_reserved_mem.h>
 #include <linux/platform_device.h>
 #include <linux/reset.h>
 #include <linux/sys_soc.h>
@@ -244,6 +245,7 @@ static int ehci_platform_probe(struct platform_device *dev)
 	struct ehci_platform_priv *priv;
 	struct ehci_hcd *ehci;
 	int err, irq, clk = 0;
+	struct resource *mem_pool;
 
 	if (usb_disabled())
 		return -ENODEV;
@@ -315,6 +317,23 @@ static int ehci_platform_probe(struct platform_device *dev)
 		}
 	}
 
+	/* Searching for reserved mem for DMA POOL */
+	err = of_reserved_mem_device_init_by_idx(&dev->dev,
+						 dev->dev.of_node, 0);
+	if (!err) {
+		/* Searching for reserved genpool for DMA buffer area */
+		mem_pool = platform_get_resource_byname(dev, IORESOURCE_MEM,
+							"mem_pool");
+		if (mem_pool) {
+			err = usb_hcd_setup_local_mem(hcd, mem_pool->start,
+						      mem_pool->start,
+						      resource_size(mem_pool));
+			if (err < 0)
+				goto err_put_clks;
+		}
+	} else if (err != -ENODEV)
+		goto err_put_clks;
+
 	priv->rsts = devm_reset_control_array_get_optional_shared(&dev->dev);
 	if (IS_ERR(priv->rsts)) {
 		err = PTR_ERR(priv->rsts);
diff --git a/drivers/usb/host/ohci-platform.c b/drivers/usb/host/ohci-platform.c
index 56d3c2d7139c..9208749d2f9e 100644
--- a/drivers/usb/host/ohci-platform.c
+++ b/drivers/usb/host/ohci-platform.c
@@ -22,6 +22,7 @@
 #include <linux/module.h>
 #include <linux/err.h>
 #include <linux/of.h>
+#include <linux/of_reserved_mem.h>
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
 #include <linux/reset.h>
@@ -94,6 +95,7 @@ static int ohci_platform_probe(struct platform_device *dev)
 	struct usb_ohci_pdata *pdata = dev_get_platdata(&dev->dev);
 	struct ohci_platform_priv *priv;
 	struct ohci_hcd *ohci;
+	struct resource *mem_pool;
 	int err, irq, clk = 0;
 
 	if (usb_disabled())
@@ -167,6 +169,23 @@ static int ohci_platform_probe(struct platform_device *dev)
 			goto err_put_clks;
 	}
 
+	/* Searching for reserved mem for DMA POOL */
+	err = of_reserved_mem_device_init_by_idx(&dev->dev,
+						dev->dev.of_node, 0);
+	if (!err) {
+		/* Searching for reserved genpool for DMA buffer area */
+		mem_pool = platform_get_resource_byname(dev, IORESOURCE_MEM,
+							"mem_pool");
+		if (mem_pool) {
+			err = usb_hcd_setup_local_mem(hcd, mem_pool->start,
+						      mem_pool->start,
+						      resource_size(mem_pool));
+			if (err < 0)
+				goto err_put_clks;
+		}
+	} else if (err != -ENODEV)
+		goto err_put_clks;
+
 	if (pdata->big_endian_desc)
 		ohci->flags |= OHCI_QUIRK_BE_DESC;
 	if (pdata->big_endian_mmio)
-- 
