From cd594aa913f8e87ab3deb159f3f7e950ae7e608b Mon Sep 17 00:00:00 2001
From: Cuong Nguyen <cuong.nguyen-van@banvien.com.vn>
Date: Fri, 19 Sep 2025 11:14:58 +0700
Upstream-Status: Inappropriate because this only for RZ-platforms
Subject: [PATCH] desktop-shell: Adjust XWayland surface position to avoid
 overlapping panel

Ensure that surfaces created by XWayland do not overlapped by the panel
by checking the panel position and adjusting the coordinates if needed.
This improves window placement behavior when the panel is positioned at
the top or the left of the screen.

Signed-off-by: Cuong Nguyen <cuong.nguyen-van@banvien.com.vn>
---
 desktop-shell/shell.c | 71 ++++++++++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 67 insertions(+), 4 deletions(-)

diff --git a/desktop-shell/shell.c b/desktop-shell/shell.c
index 552ef44..3f27565 100644
--- a/desktop-shell/shell.c
+++ b/desktop-shell/shell.c
@@ -2222,17 +2222,80 @@ static void
 set_position_from_xwayland(struct shell_surface *shsurf)
 {
 	struct weston_geometry geometry;
-	struct weston_coord_surface offs;
+	struct weston_coord_surface offs, origin_s;
+	struct desktop_shell *shell;
+	struct weston_coord_global pos, newpos, origin_g, global_offset;
+	pixman_rectangle32_t area;
 
 	assert(shsurf->xwayland.is_set);
 
 	geometry = weston_desktop_surface_get_geometry(shsurf->desktop_surface);
 	offs = weston_coord_surface(-geometry.x, -geometry.y,
 				    shsurf->view->surface);
+	shell = shell_surface_get_shell(shsurf);
+	pos = shsurf->xwayland.pos;
+	get_output_work_area(shell, shsurf->output, &area);
+
+	/*
+	 * +----------------------------------------------+  <- Screen
+	 * | ##############  PANEL (TOP)  ############### |  <- Top panel
+	 * +----------------------------------------------+
+	 * |                                              |
+	 * |         <---- WORK AREA (area) ---->         |  <- Usable area (excluding panel)
+	 * |                                              |
+	 * |                                              |
+	 * |                                              |
+	 * +----------------------------------------------+
+	 *
+	 * If the client does not specify an initial position, the view may appear at
+	 * (0,0). With a top panel (Weston bar), this puts the window under the panel,
+	 * making it difficult or impossible to interact with (move/resize/maximize).
+	 *
+	 * To clamp correctly, compute the global offset vector between the global surface
+	 * origin and the window geometry's top-left corner, then use it to predict where
+	 * the window-geometry edges would be if the view were placed at 'pos'.
+	 *
+	 * Steps:
+	 * 1) Ensure transforms are up to date for local-to-global conversions.
+	 * 2) Compute the global_offset:
+	 *        global_offset = global(offs) - global(origin_s)
+	 * 3) Predict the window-geometry edges at the requested 'pos':
+	 *        newpos  = pos + global_offset
+	 * 4) Clamp newpos so the geometry stays inside the work area:
+	 *        if (newpos.c.y < area.y) newpos.c.y = area.y;
+	 *        if (newpos.c.x < area.x) newpos.c.x = area.x;
+	 */
+
+	origin_s = weston_coord_surface(0, 0, shsurf->view->surface);
+
+	/* Temporarily update the transform so local-to-global conversions are accurate */
+	weston_view_set_position(shsurf->view, pos);
+	weston_view_update_transform(shsurf->view);
+
+	origin_g = weston_coord_surface_to_global(shsurf->view, origin_s);
+	global_offset = weston_coord_surface_to_global(shsurf->view, offs);
+	global_offset = weston_coord_global_sub(global_offset, origin_g);
+
+	/* Predict where the window-geometry edges would be if the view were placed at 'pos' */
+	newpos = weston_coord_global_add(weston_view_get_pos_offset_global(shsurf->view),
+						global_offset);
+
+	switch (shell->panel_position) {
+	case WESTON_DESKTOP_SHELL_PANEL_POSITION_TOP:
+		/* Clamp: top edge of window geometry must not overlap the top panel */
+		if (newpos.c.y < area.y)
+			newpos.c.y = area.y;
+		break;
+	case WESTON_DESKTOP_SHELL_PANEL_POSITION_LEFT:
+		/* Clamp: left edge of window geometry must not overlap the left panel */
+		if (newpos.c.x < area.x)
+			newpos.c.x = area.x;
+		break;
+	default:
+		break;
+	}
 
-	weston_view_set_position_with_offset(shsurf->view,
-					     shsurf->xwayland.pos,
-					     offs);
+	weston_view_set_position(shsurf->view, newpos);
 
 #ifdef WM_DEBUG
 	weston_log("%s: XWM %d, %d; geometry %d, %d; view %f, %f\n",
-- 
2.7.4

