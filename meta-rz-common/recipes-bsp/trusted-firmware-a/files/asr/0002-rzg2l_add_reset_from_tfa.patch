 	.pwr_domain_on						= rzg2l_pwr_domain_on,
 	.pwr_domain_on_finish				= rzg2l_pwr_domain_on_finish,
 	.pwr_domain_off						= rzg2l_pwr_domain_off,
-	.system_off                                     = rzg2l_system_off,
+	/*****PSCI_SYSTEM_OFF*****/
+	.system_off							= rzg2l_system_off,
+	/*****PSCI_SYSTEM_RESET*****/
+	.system_reset						= rzg2l_system_reset,
 };
 
