+/******************************************************************************
+ * Function:		vsp_ins_deassert_reset
+ * Description:	Deassert VSP/FCP resets.
+ * Returns:		0
+ ******************************************************************************/
+long vsp_ins_deassert_reset(struct vsp_prv_data *prv, unsigned char ch)
+{
+	int i, loopcnt;
+
+	/* deassert reset controllers to start VSP */
+	for (i = (RSTNUM * ch); i < ((RSTNUM * ch) + RSTNUM); i++) {
+		if (reset_control_deassert(prv->rsts[i])) {
+			EPRINT("%s: failed to deassert resets!! \n", __func__);
+			return E_VSP_NO_RST;
+		}
+
+		/* waiting deassert process */
+		loopcnt = VSP_STATUS_LOOP_CNT;
+		do {
+			/* sleep */
+			msleep(VSP_STATUS_LOOP_TIME);
+		} while ((reset_control_status(prv->rsts[i])) &&
+			(--loopcnt > 0));
+
+		if (loopcnt == 0) {
+			EPRINT("%s: happen to timeout after deassert resets!! \n",
+				__func__);
+		}
+	}
+
+	return 0;
+}
+
+/******************************************************************************
+ * Function:		vsp_ins_assert_reset
+ * Description:	Aassert VSP/FCP resets.
+ * Returns:		0
+ ******************************************************************************/
+long vsp_ins_assert_reset(struct vsp_prv_data *prv, unsigned char ch)
+{
+	int i;
+
+	/* assert reset controllers to stop VSP */
+	for (i = ((RSTNUM * ch) + RSTNUM - 1); i >= (RSTNUM * ch); i--) {
+		if (prv->rsts[i]) {
+			if (reset_control_assert(prv->rsts[i])) {
+				EPRINT("%s: failed to assert resets!! \n", __func__);
+				return E_VSP_NO_RST;
+			}
+		}
+	}
+
+	return 0;
+}
+
