 {
 	struct vsp2_brs *brs = to_brs(&entity->subdev);
@@ -332,8 +436,12 @@ static void brs_configure(struct vsp2_entity *entity,
 		brs->entity.vsp2->vspm->ip_par.par.vsp;
 	struct vsp_brs_t *vsp_brs = vsp_par->ctrl_par->brs;
 	u32 inctrl;
-
