From eec3ca670a169c1476b9ddc0bee70d89448a2002 Mon Sep 17 00:00:00 2001
From: Hiep Pham <hiep.pham.zy@renesas.com>
Date: Tue, 3 Mar 2026 14:24:21 +0700
Subject: [PATCH 5/7] arm64: dts: renesas: r9a09g047e57-smarc: enable LVDS
 support

Enable LVDS support for RZ/G3E smarc.

Signed-off-by: Hien Huynh <hien.huynh.px@renesas.com>
Signed-off-by: Hiep Pham <hiep.pham.zy@renesas.com>
---
 arch/arm64/boot/dts/renesas/r9a09g047e57-smarc.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/renesas/r9a09g047e57-smarc.dts b/arch/arm64/boot/dts/renesas/r9a09g047e57-smarc.dts
index 42fc2ca2eb9be..94f8822dbddb8 100644
--- a/arch/arm64/boot/dts/renesas/r9a09g047e57-smarc.dts
+++ b/arch/arm64/boot/dts/renesas/r9a09g047e57-smarc.dts
@@ -44,7 +44,7 @@
  */
 
 #define RZG3E_SMARC_MIPI_DSI_ENABLE	1
-#define RZG3E_SMARC_LVDS_ENABLE 	0
+#define RZG3E_SMARC_LVDS_ENABLE 	1
 
 /* Only maximum 2 display selections are enabled at the same time */
 #if (RZG3E_SMARC_MIPI_DSI_ENABLE & RZG3E_SMARC_LVDS_ENABLE & SW_LCD_EN)
