From 151f930d1eaeeb0d32e2b7b693f4bcffcc1fe2af Mon Sep 17 00:00:00 2001
From: Linh Hua <linh.hua.jc@renesas.com>
Date: Thu, 13 Mar 2025 11:09:04 +0700
Subject: [PATCH] configs: rzf_defconfig: enable ECC configs support for
 RZ/Five

Enable ECC configs support for RZ/Five SMARC and Development EVK
DDR4 Boards.

Signed-off-by: Hien Huynh <hien.huynh.px@renesas.com>
Signed-off-by: Linh Hua <linh.hua.jc@renesas.com>
---
 configs/rzf-dev_ddr4_defconfig | 3 ++-
 configs/smarc-rzf_defconfig    | 4 +++-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/configs/rzf-dev_ddr4_defconfig b/configs/rzf-dev_ddr4_defconfig
index 70f8e39d542..0767c33483f 100644
--- a/configs/rzf-dev_ddr4_defconfig
+++ b/configs/rzf-dev_ddr4_defconfig
@@ -137,4 +137,5 @@ CONFIG_RZF_DDR_SIZE=0x40000000
 CONFIG_DEBUG_OPENSBI=y
 CONFIG_SBI_V02=y
 CONFIG_CMD_EXCEPTION=y
-
+CONFIG_CMD_RZG2L_ECC=y
+CONFIG_RZF_DDR_ECC=y
diff --git a/configs/smarc-rzf_defconfig b/configs/smarc-rzf_defconfig
index 49b7e92ce03..ccfc9ce96fb 100644
--- a/configs/smarc-rzf_defconfig
+++ b/configs/smarc-rzf_defconfig
@@ -109,7 +109,7 @@ CONFIG_SPL_BSS_START_ADDR=0x48000000
 CONFIG_SPL_STACK=0x30000
 CONFIG_SYS_SPL_MALLOC=y
 CONFIG_SYS_SPL_MALLOC_SIZE=0x200000
-CONFIG_SPL_MAX_SIZE=0x00013000
+CONFIG_SPL_MAX_SIZE=0x100000
 CONFIG_SYS_BARGSIZE=2048
 CONFIG_SPL_BSS_MAX_SIZE=0x100000
 CONFIG_SYS_MALLOC_LEN=0x8000000
@@ -168,3 +168,5 @@ CONFIG_USB_RENESAS_USBHS=y
 CONFIG_USB_GADGET_DOWNLOAD=y
 CONFIG_USB_FUNCTION_MASS_STORAGE=y
 CONFIG_CMD_USB_MASS_STORAGE=y
+CONFIG_CMD_RZG2L_ECC=y
+CONFIG_RZF_DDR_ECC=y
-- 
2.25.1

